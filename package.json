{
  "name": "decky-wake-on-controller",
  "version": "1.0.0",
  "description": "Wake your Steam Deck from sleep by pressing the home button on any Bluetooth controller",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@decky/api": "*",
    "@decky/ui": "*",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/react": "^19.1.1",
    "rollup": "^4.53.3",
    "rollup-plugin-delete": "^2.0.0",
    "tslib": "*",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
